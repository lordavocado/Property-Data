#!/usr/bin/env bash
# Prepares a fresh Amp orb: Node.js 24 + npm deps (dashboard) and Poetry + Python deps (homeharvest).
# Idempotent and non-interactive; safe to re-run on a stale snapshot.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() { echo "==> $* ($(date +%T))"; }

# --- Node.js -----------------------------------------------------------------
# The repository pins no Node.js version (no .nvmrc/.node-version/engines), so use Node.js 24.
NODE_MAJOR=24
node_root="$HOME/.local/share/node-v$NODE_MAJOR"
bin_dir="$HOME/.local/bin" # precedes /usr/local/bin on the orb PATH
mkdir -p "$bin_dir"

if [[ "$("$node_root/bin/node" --version 2>/dev/null || true)" != v$NODE_MAJOR.* ]]; then
  step "Installing Node.js $NODE_MAJOR"
  base="https://nodejs.org/dist/latest-v$NODE_MAJOR.x"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  tarball="$(curl -fsSL "$base/SHASUMS256.txt" | awk '/linux-x64\.tar\.xz$/ {print $2}')"
  curl -fsSL "$base/$tarball" -o "$tmp/$tarball"
  (cd "$tmp" && curl -fsSL "$base/SHASUMS256.txt" | grep " $tarball\$" | sha256sum -c -)
  rm -rf "$node_root"
  mkdir -p "$node_root"
  tar -xJf "$tmp/$tarball" -C "$node_root" --strip-components=1
fi
for tool in node npm npx corepack; do
  ln -sfn "$node_root/bin/$tool" "$bin_dir/$tool"
done
export PATH="$bin_dir:$PATH"
echo "node $(node --version), npm $(npm --version)"

step "npm ci"
npm ci --no-audit --no-fund

# --- Python (Poetry) -----------------------------------------------------------
# poetry.lock was generated by Poetry 2.2.1.
POETRY_VERSION=2.2.1
if [[ "$(poetry --version 2>/dev/null || true)" != *"$POETRY_VERSION"* ]]; then
  step "Installing Poetry $POETRY_VERSION"
  uv tool install --force "poetry==$POETRY_VERSION"
fi

step "poetry sync"
poetry check --lock
poetry sync --no-interaction

step "Setup complete"
