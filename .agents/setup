#!/usr/bin/env bash
# Prepares a fresh Amp orb: Node.js 24 + npm deps (dashboard) and Poetry + Python deps (homeharvest).
# Idempotent and non-interactive; safe to re-run on a stale snapshot.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() { echo "==> $* ($(date +%T))"; }

# --- Node.js -----------------------------------------------------------------
# The repository pins no Node.js version (no .nvmrc/.node-version/engines), so use Node.js 24.
NODE_MAJOR=24
node_root="$HOME/.local/share/node-v$NODE_MAJOR"
bin_dir="$HOME/.local/bin" # precedes /usr/local/bin on the orb PATH
mkdir -p "$bin_dir"

if [[ "$("$node_root/bin/node" --version 2>/dev/null || true)" != v$NODE_MAJOR.* ]] ||
  [[ ! -x "$node_root/bin/npm" ]]; then
  step "Installing Node.js $NODE_MAJOR"
  base="https://nodejs.org/dist/latest-v$NODE_MAJOR.x"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  tarball="$(curl -fsSL "$base/SHASUMS256.txt" | awk '/linux-x64\.tar\.xz$/ {print $2}')"
  curl -fsSL "$base/$tarball" -o "$tmp/$tarball"
  (cd "$tmp" && curl -fsSL "$base/SHASUMS256.txt" | grep " $tarball\$" | sha256sum -c -)
  rm -rf "$node_root"
  mkdir -p "$node_root"
  tar -xJf "$tmp/$tarball" -C "$node_root" --strip-components=1
fi
for tool in node npm npx corepack; do
  ln -sfn "$node_root/bin/$tool" "$bin_dir/$tool"
done
export PATH="$bin_dir:$PATH"
echo "node $(node --version), npm $(npm --version)"

step "npm ci"
npm ci --include=dev --no-audit --no-fund

# --- Python (Poetry) -----------------------------------------------------------
# poetry.lock was generated by Poetry 2.2.1.
POETRY_VERSION=2.2.1
if [[ "$(poetry --version 2>/dev/null || true)" != *"$POETRY_VERSION"* ]]; then
  step "Installing Poetry $POETRY_VERSION"
  uv tool install --force "poetry==$POETRY_VERSION"
fi

step "poetry sync"
# Always install into Poetry's own virtualenv, which .agents/resume checks.
export POETRY_VIRTUALENVS_CREATE=true
unset VIRTUAL_ENV
poetry check --lock
poetry sync --no-interaction

# --- MongoDB -----------------------------------------------------------------
# The API (server/db.ts) defaults to mongodb://127.0.0.1:27017/homeharvest. Run a local,
# empty mongod under systemd so it survives setup and starts in orbs restored from the snapshot.
MONGO_SERIES=8.0
if ! command -v mongod >/dev/null; then
  step "Installing MongoDB $MONGO_SERIES"
  keyring=/usr/share/keyrings/mongodb-server-$MONGO_SERIES.gpg
  curl -fsSL "https://www.mongodb.org/static/pgp/server-$MONGO_SERIES.asc" | sudo gpg --batch --yes --dearmor -o "$keyring"
  echo "deb [signed-by=$keyring] https://repo.mongodb.org/apt/debian bookworm/mongodb-org/$MONGO_SERIES main" |
    sudo tee /etc/apt/sources.list.d/mongodb-org-$MONGO_SERIES.list >/dev/null
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq mongodb-org-server mongodb-mongosh
fi
# Small cache for a dev orb; durability does not matter here.
if ! grep -q 'cacheSizeGB' /etc/mongod.conf; then
  sudo sed -i 's/^storage:$/storage:\n  wiredTiger:\n    engineConfig:\n      cacheSizeGB: 0.5/' /etc/mongod.conf
fi
sudo systemctl enable --now mongod
for _ in $(seq 30); do
  mongosh --quiet --eval 'db.runCommand({ ping: 1 }).ok' >/dev/null 2>&1 && break
  sleep 1
done
mongosh --quiet --eval 'db.runCommand({ ping: 1 }).ok' >/dev/null || { echo "mongod did not start" >&2; exit 1; }
echo "mongod $(mongod --version | awk 'NR==1 {print $3}') running"

step "Setup complete"
