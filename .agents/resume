#!/usr/bin/env bash
# Fast health check when an orb wakes; installs nothing.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.local/bin:$PATH"

fail() { echo "resume: $* (run .agents/setup)" >&2; exit 1; }

node_major="$(tr -d '[:space:]v' < .nvmrc)"
[[ "$(node --version 2>/dev/null)" == "v$node_major."* ]] || fail "Node.js $node_major (.nvmrc) not found on PATH"
[[ -x node_modules/.bin/vite && -x node_modules/.bin/tsc ]] || fail "npm dependencies missing"
command -v poetry >/dev/null || fail "poetry not found"
unset VIRTUAL_ENV # match .agents/setup, so Poetry reports the project virtualenv
venv="$(poetry env info --path 2>/dev/null)" || fail "Poetry virtualenv missing"
"$venv/bin/python" -c "import homeharvest, pandas, pytest" 2>/dev/null || fail "Python dependencies missing"

systemctl is-active --quiet mongod || sudo systemctl start mongod || fail "mongod failed to start"
# mongod.service is Type=simple, so "active" does not mean it accepts connections yet.
for _ in 1 2 3 4 5; do
  mongosh --quiet --eval 'db.runCommand({ ping: 1 }).ok' >/dev/null 2>&1 && break
  sleep 1
done
mongosh --quiet --eval 'db.runCommand({ ping: 1 }).ok' >/dev/null 2>&1 || fail "MongoDB is not answering on 127.0.0.1:27017"

echo "resume: node $(node --version), poetry env $venv, mongod OK"
